  "dependencies": {
    "express": "^5.2.1",
    "NeteaseCloudMusicApi": "4.32.0"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "devDependencies": {
    "fs-monkey": "^1.1.0",
    "memfs": "^4.80.0",
    "unionfs": "^4.6.0"
  }
}
