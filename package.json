{
  "name": "netease-music-service",
  "version": "1.0.0",
  "description": "本地网易云音乐服务：自有账号解析/下载无损、每日推荐、私人电台、官方榜单（core 原子能力 + service 编排两层架构）",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "stop": "node stop.js",
    "login": "node login.js",
