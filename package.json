    "test:unit": "node test/unit.test.js",
    "test:unit:io": "node test/unit.test.js --io"
  },
  "keywords": [
    "netease",
    "netease-cloud-music",
    "music",
    "download",
    "lossless",
    "flac",
    "lyrics",
    "playlist"
